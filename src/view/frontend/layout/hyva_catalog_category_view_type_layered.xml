<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Affirm declares its sidebar banner again for layered categories. The banner that replaces it is
             declared once for every category page in hyva_catalog_category_view.xml. -->
        <referenceBlock name="bml.right.banner.top" remove="true"/>
    </body>
</page>
