<?php declare(strict_types=1);
/**
 * Copyright (c) 2026 Breda Beds. Licensed under the MIT licence; see LICENSE.
 *
 * Price-state recorder for product page messages: window.hyvaAffirmPriceState, contract v1:
 *   {v: 1, global: {finalPrice, optionPrices, activeOptions: {[optionId]: bool}, bundleOptionPrices,
 *   configurableSelection: {[productId]: detail}}, products: {[productId]: {prices, qty}}}
 *
 * Hyvä's price events are not replayed for late subscribers: the custom option and configurable components
 * announce their preselected values once, while a message component can start later (x-defer, a deferred
 * parent, the cart "configure" page). This script keeps the latest payloads so components start from the
 * current state, and announces every change with the window event `hyva-affirm:price-state`
 * (detail {type, productId}; productId is null for page-global events). Product ids are read from the
 * elements carrying data-hyva-affirm-product-id; a component can request tracking of another id with the
 * window event `hyva-affirm:price-state-track` (detail {productId}).
 *
 * Ordering: message blocks render in the page content and register this template as a page JS dependency
 * (hyva_js_template_dependencies). Hyvä's page-js-dependencies block renders it later, in before.body.end (a
 * block placed in before.body.end itself would need before="page-js-dependencies" to register in time). It is
 * a classic inline script at the end of the body, so it runs during parsing: after every message element
 * exists and before Alpine, a deferred module script, starts the components that dispatch the price events.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp
 */
?>
<script>
(() => {
    'use strict';
    if (window.hyvaAffirmPriceState) {
        return;
    }

    /* recorder:start */
    // Page-global Hyvä price events (no product id in name or payload).
    const PRICE_EVENTS = [
        'update-product-final-price',
        'update-custom-option-prices',
        'update-custom-option-active',
        'update-bundle-option-prices',
        'configurable-selection-changed',
    ];

    // Per-product events, dispatched as `<type>-<productId>`.
    const PRODUCT_EVENTS = ['update-prices', 'update-qty'];

    const createPriceState = () => ({
        v: 1,
        global: {
            finalPrice: null,
            optionPrices: null,
            activeOptions: {},
            bundleOptionPrices: null,
            configurableSelection: {},
        },
        products: {},
    });

    // Event payload ids (product, option) as object keys; '' when absent.
    const toKey = (value) => (value === undefined || value === null ? '' : String(value));

    // Adds a product entry; false when the id is empty or already tracked.
    const trackProduct = (state, productId) => {
        const id = toKey(productId);
        if (id === '' || state.products[id]) {
            return false;
        }
        state.products[id] = {prices: null, qty: null};
        return true;
    };

    // Applies one event payload to the state with the semantics of Hyvä's price.phtml; true when it changed.
    const recordPriceEvent = (state, type, detail, productId) => {
        const global = state.global;
        switch (type) {
            case 'update-product-final-price':
                global.finalPrice = detail === undefined ? null : detail;
                return true;
            case 'update-custom-option-prices':
                // Every payload carries the prices of all option values and replaces the previous map.
                if (!detail || typeof detail !== 'object') {
                    return false;
                }
                global.optionPrices = detail;
                return true;
            case 'update-custom-option-active': {
                const optionId = detail && typeof detail === 'object' ? toKey(detail.customOptionId) : '';
                if (optionId === '') {
                    return false;
                }
                global.activeOptions[optionId] = !!detail.active;
                return true;
            }
            case 'update-bundle-option-prices':
                global.bundleOptionPrices = detail === undefined ? null : detail;
                return true;
            case 'configurable-selection-changed': {
                const configurableId = detail && typeof detail === 'object' ? toKey(detail.productId) : '';
                if (configurableId === '') {
                    return false;
                }
                global.configurableSelection[configurableId] = detail;
                return true;
            }
            case 'update-prices':
            case 'update-qty': {
                const id = toKey(productId);
                if (id === '') {
                    return false;
                }
                trackProduct(state, id);
                state.products[id][type === 'update-prices' ? 'prices' : 'qty'] = detail === undefined ? null : detail;
                return true;
            }
            default:
                return false;
        }
    };
    /* recorder:end */

    const state = createPriceState();
    window.hyvaAffirmPriceState = state;

    const listen = (eventName, type, productId) => {
        window.addEventListener(eventName, (event) => {
            if (recordPriceEvent(state, type, event.detail, productId)) {
                window.dispatchEvent(new CustomEvent('hyva-affirm:price-state', {
                    detail: {type, productId: productId === undefined ? null : productId},
                }));
            }
        }, {passive: true});
    };
    const track = (productId) => {
        if (trackProduct(state, productId)) {
            const id = toKey(productId);
            PRODUCT_EVENTS.forEach((type) => listen(type + '-' + id, type, id));
        }
    };

    PRICE_EVENTS.forEach((type) => listen(type, type));
    document.querySelectorAll('[data-hyva-affirm-product-id]')
        .forEach((element) => track(element.dataset.hyvaAffirmProductId));
    window.addEventListener('hyva-affirm:price-state-track', (event) => track(event.detail && event.detail.productId));
})();
</script>
<?php if (isset($hyvaCsp)) {
    $hyvaCsp->registerInlineScript();
} ?>
