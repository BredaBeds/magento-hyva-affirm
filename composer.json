{
    "name": "bredabeds/magento-hyva-affirm",
    "description": "Hyvä Theme compatibility for Affirm's Magento 2 extension (affirm/magento2): promotional messaging, banners, cart button and order-confirmed pixel",
    "type": "magento2-module",
    "version": "0.1.2",
    "license": "MIT",
    "keywords": [
        "magento2",
        "hyva",
        "hyva-theme",
        "affirm",
        "payments"
    ],
    "homepage": "https://github.com/BredaBeds/magento-hyva-affirm",
    "authors": [
        {
            "name": "Breda Beds",
            "homepage": "https://github.com/BredaBeds"
        }
    ],
    "support": {
        "issues": "https://github.com/BredaBeds/magento-hyva-affirm/issues",
        "source": "https://github.com/BredaBeds/magento-hyva-affirm"
    },
    "require": {
        "php": "^8.1",
        "affirm/magento2": "^4.0.11",
        "hyva-themes/magento2-compat-module-fallback": "^1.1.2",
        "hyva-themes/magento2-theme-module": "^1.3.11",
        "magento/framework": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-catalog-inventory": "^100.4",
        "magento/module-checkout": "^100.4",
        "magento/module-payment": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-tax": "^100.4"
    },
    "suggest": {
        "hyva-themes/magento2-hyva-checkout": "The cart page 'Checkout with Affirm' button then opens Hyvä Checkout's payment step"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Hyva\\AstoundAffirm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyva\\AstoundAffirm\\Test\\": "Test/"
        }
    }
}
